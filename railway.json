{
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install && cd artifacts/pos-system && pnpm run build"
  },
  "deploy": {
    "startCommand": "cd artifacts/pos-system && pnpm run start",
    "healthcheckPath": "/",
    "healthcheckTimeout": 100,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
